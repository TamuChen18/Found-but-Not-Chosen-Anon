# Copy to .env and fill in. Only needed to generate new candidate pools or new LLM decisions;
# scripts/reproduce_all.sh runs offline and ignores this file.

# OpenRouter (GPT-4o-mini generation, GPT-4o judge / Top-3 verifier / Top-3 selector)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Qwen3.5-9B through a local vLLM server (see README, "Generating new pools")
# OPENROUTER_BASE_URL=http://127.0.0.1:8000/v1
# OPENROUTER_ENABLE_THINKING=0

# Final protocol: no request seed
# OPENROUTER_SEND_SEED=0

# Optional per-request call log (JSONL: sampling parameters, finish reasons, token usage)
# OPENROUTER_CALL_LOG=logs/calls.jsonl

# OpenAI backend (--api openai)
# OPENAI_API_KEY=your_openai_key_here

# Optional: disable wandb without passing --disable_wandb
# WANDB_MODE=disabled
